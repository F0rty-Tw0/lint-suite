{
  "name": "@lint-suite/rule-internals",
  "private": true,
  "type": "module",
  "exports": {
    "./utils/*.ts": "./src/utils/*.ts",
    "./common/*.ts": "./src/common/*.ts",
    "./stubs/*.ts": "./src/stubs/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "devDependencies": {
    "eslint": "catalog:dev",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev",
    "@typescript-eslint/utils": "catalog:typescript",
    "@angular/compiler": "catalog:angular",
    "typescript": "catalog:typescript",
    "postcss": "catalog:styles",
    "postcss-scss": "catalog:styles",
    "postcss-selector-parser": "catalog:styles",
    "@lint-suite/rule-test-support": "workspace:*"
  }
}
