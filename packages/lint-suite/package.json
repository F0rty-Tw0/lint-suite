{
  "name": "lint-suite",
  "version": "2.1.0",
  "description": "Reusable ESLint, Stylelint, and Prettier configurations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F0rty-Tw0/lint-suite.git",
    "directory": "packages/lint-suite"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "lint",
    "typescript",
    "angular",
    "storybook",
    "json",
    "rxjs",
    "vitest",
    "playwright",
    "stylelint",
    "prettier"
  ],
  "license": "MIT",
  "author": "Artiom Tofan artiomtofancv@gmail.com",
  "type": "module",
  "dependencies": {
    "@lint-suite/eslint-plugin-arrow-body-fits-line": "workspace:*",
    "@lint-suite/eslint-plugin-chain-fits-line": "workspace:*",
    "@lint-suite/eslint-plugin-chain-receiver-is-name": "workspace:*",
    "@lint-suite/eslint-plugin-explicit-accessibility": "workspace:*",
    "@lint-suite/eslint-plugin-max-condition-operands": "workspace:*",
    "@lint-suite/eslint-plugin-no-call-in-condition": "workspace:*",
    "@lint-suite/eslint-plugin-no-grouped-condition": "workspace:*",
    "@lint-suite/eslint-plugin-no-inline-object-types": "workspace:*",
    "@lint-suite/eslint-plugin-no-inline-return-object": "workspace:*",
    "@lint-suite/eslint-plugin-no-nested-object-value": "workspace:*",
    "@lint-suite/eslint-plugin-no-spread-expression": "workspace:*",
    "@lint-suite/eslint-plugin-no-unused-exports": "workspace:*",
    "@lint-suite/eslint-plugin-one-line-guard": "workspace:*",
    "@lint-suite/eslint-plugin-readonly-type-properties": "workspace:*",
    "@lint-suite/eslint-plugin-ternary-branch-shape": "workspace:*",
    "@lint-suite/eslint-plugin-test-file-shape": "workspace:*",
    "@lint-suite/eslint-plugin-type-placement": "workspace:*",
    "@lint-suite/eslint-plugin-util-purity": "workspace:*",
    "@lint-suite/eslint-plugin-no-unused-angular-instance-fields": "workspace:*",
    "@lint-suite/eslint-plugin-no-unstyled-classes": "workspace:*",
    "@lint-suite/stylelint-no-unused-classes": "workspace:*",
    "@eslint/js": "catalog:javascript",
    "@eslint/json": "catalog:json",
    "@nx/eslint-plugin": "catalog:base",
    "@smarttools/eslint-plugin-rxjs": "catalog:rxjs",
    "@stylistic/eslint-plugin": "catalog:base",
    "@vitest/eslint-plugin": "catalog:vitest",
    "angular-eslint": "catalog:angular",
    "eslint": "catalog:base",
    "eslint-config-prettier": "catalog:prettier",
    "eslint-import-resolver-typescript": "catalog:typescript",
    "eslint-plugin-boundaries": "catalog:boundaries",
    "eslint-plugin-import-x": "catalog:base",
    "eslint-plugin-playwright": "catalog:playwright",
    "eslint-plugin-storybook": "catalog:storybook",
    "globals": "catalog:angular",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recess-order": "catalog:stylelint",
    "stylelint-config-standard": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "stylelint-scss": "catalog:stylelint",
    "stylelint-selector-bem-pattern": "catalog:stylelint",
    "typescript-eslint": "catalog:typescript"
  },
  "peerDependencies": {
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript-compatibility"
  },
  "scripts": {
    "build": "nx build lint-suite"
  },
  "exports": {
    "./package.json": "./package.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./stylelint": {
      "types": "./stylelint.d.ts",
      "default": "./stylelint.js"
    },
    "./prettier": {
      "types": "./prettier.d.ts",
      "default": "./prettier.js"
    }
  },
  "files": [
    "./**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "catalog:typescript"
  }
}
