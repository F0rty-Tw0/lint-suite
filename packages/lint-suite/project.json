{
  "name": "lint-suite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/lint-suite/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}/src"]
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "packages/lint-suite/src/eslint.ts",
        "additionalEntryPoints": [
          "packages/lint-suite/src/stylelint.ts",
          "packages/lint-suite/src/prettier.ts"
        ],
        "outputPath": "dist",
        "tsConfig": "packages/lint-suite/tsconfig.lib.json",
        "platform": "node",
        "format": ["esm", "cjs"],
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/lint-suite",
            "output": "packages/lint-suite/src"
          },
          {
            "glob": "LICENSE",
            "input": "packages/lint-suite",
            "output": "packages/lint-suite/src"
          },
          {
            "glob": "package.json",
            "input": "packages/lint-suite",
            "output": "packages/lint-suite/src"
          }
        ],
        "minify": false,
        "generatePackageJson": false,
        "sourcemap": true,
        "bundle": true,
        "thirdParty": false,
        "esbuildOptions": {
          "outbase": "."
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --import @swc-node/register/esm-register --test --test-isolation=none packages/lint-suite/src/lib/rules/no-unused-angular-instance-fields/no-unused-instance-fields.spec.ts packages/lint-suite/src/lib/rules/no-unused-angular-instance-fields/no-unused-instance-fields.project.spec.ts",
        "env": {
          "SWC_NODE_PROJECT": "packages/lint-suite/tsconfig.json"
        }
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}/src"
      }
    }
  }
}
