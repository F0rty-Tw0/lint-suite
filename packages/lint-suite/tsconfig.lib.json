{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/fixtures/**",
    "src/**/common/stubs/**",
    "src/**/*.spec.ts",
    "src/**/*.spec.util.ts"
  ]
}
