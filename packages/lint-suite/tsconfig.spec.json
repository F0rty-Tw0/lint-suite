{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/spec",
    "types": ["vitest", "node"]
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec-support.ts",
    "src/**/*.project-fixture.ts"
  ],
  "exclude": ["src/**/fixtures/**"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
