{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/spec",
    "types": [
      "vitest",
      "node"
    ],
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "../../eslint.config.base.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "src/**/common/stubs/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.util.ts"
  ],
  "exclude": [
    "src/**/fixtures/**"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
