{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/spec",
    "types": [
      "vitest",
      "node"
    ]
  },
  "include": [
    "vitest.config.ts",
    "src/**/common/stubs/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.util.ts"
  ],
  "exclude": [
    "src/**/fixtures/**"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
