{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "*.config.ts",
    "../../lint-suite/src/types/*.d.ts"
  ],
  "exclude": ["**/fixtures/**"],
  "nx": {
    "addTypecheckTarget": false
  }
}
