{
  "name": "tools",
  "sourceRoot": "tools/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "command": "tsc -p tools/tsconfig.lib.json --noEmit && tsc -p tools/tsconfig.spec.json --noEmit"
    },
    "lint": {
      "command": "eslint tools --config tools/eslint.config.ts --max-warnings=0"
    },
    "test": {
      "command": "vitest run --config tools/vitest.config.ts",
      "options": {
        "cwd": "."
      },
      "dependsOn": [
        {
          "projects": ["*"],
          "target": "build"
        }
      ]
    }
  }
}
