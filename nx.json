{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/test/**"
    ],
    "lintConfig": [
      "{workspaceRoot}/eslint.config.base.ts",
      "{workspaceRoot}/eslint.config.dogfood.ts",
      "{workspaceRoot}/packages/lint-suite/src/**/*.ts",
      "{workspaceRoot}/packages/eslint/*/src/**/*.ts",
      "{workspaceRoot}/shared/*/src/**/*.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tools/**/*.ts"
    ]
  },
  "targetDefaults": {
    "build": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
        "options": {
          "command": "node tools/src/build-package.ts {projectRoot}"
        }
      }
    ],
    "typecheck": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default", "lintConfig"],
        "options": {
          "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
        }
      }
    ],
    "lint": [
      {
        "filter": {
          "projects": ["packages/**", "shared/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default", "lintConfig"],
        "options": {
          "command": "eslint . --max-warnings=0",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--conditions=development"
          }
        }
      }
    ],
    "test": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["default", "^default"],
        "options": {
          "command": "vitest run --config {projectRoot}/vitest.config.ts"
        }
      }
    ],
    "nx-release-publish": [
      {
        "filter": {
          "projects": ["packages/**"]
        },
        "options": {
          "packageRoot": "dist/{projectRoot}"
        }
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    }
  ],
  "release": {
    "projects": [
      "eslint-arrow-fits-line",
      "eslint-chain-fits-line",
      "eslint-chain-receiver-name",
      "eslint-explicit-accessibility",
      "eslint-max-condition-operands",
      "eslint-modular-boundaries",
      "eslint-no-call-in-condition",
      "eslint-no-grouped-condition",
      "eslint-no-inline-object-types",
      "eslint-no-inline-return-object",
      "eslint-no-nested-object-value",
      "eslint-no-spread-expression",
      "eslint-no-unused-exports",
      "eslint-one-line-guard",
      "eslint-readonly-type-properties",
      "eslint-ternary-branch-shape",
      "eslint-test-file-shape",
      "eslint-type-placement",
      "eslint-util-purity",
      "eslint-no-unused-angular-fields",
      "eslint-no-unstyled-classes",
      "stylelint-no-unused-classes",
      "oxlint-config",
      "lint-suite"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}",
      "checkAllBranchesWhen": ["master"]
    },
    "version": {
      "currentVersionResolver": "disk",
      "updateDependents": "always",
      "preserveLocalDependencyProtocols": true,
      "versionPrefix": "",
      "manifestRootsToUpdate": ["{projectRoot}"],
      "versionActionsOptions": {
        "installIgnoreScripts": true
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false
      },
      "automaticFromRef": true
    }
  },
  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "analytics": false
}
